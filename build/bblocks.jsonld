        },
        {
          "prof:hasArtifact": "https://avillar.github.io/bblocks-deep-dive-01/build/annotated/deepdive1/weatherObservation/schema.json",
          "prof:hasRole": "role:schema",
          "dct:format": "application/json",
          "dct:conformsTo": "https://json-schema.org/draft/2020-12/schema"
        }
      ],
      "sourceSchema": "https://avillar.github.io/bblocks-deep-dive-01/_sources/weatherObservation/schema.yaml",
      "sourceLdContext": "https://avillar.github.io/bblocks-deep-dive-01/_sources/weatherObservation/context.jsonld",
