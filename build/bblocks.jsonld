      "validationPassed": true,
      "testOutputs": "https://github.com/avillar/bblocks-deep-dive-01/blob/main/build/tests/deepdive1/weatherObservation/",
      "transforms": [
        {
          "id": "to-summary",
          "description": "Converts an observation into a flat, human-readable **summary** record.",
          "type": "jq",
          "inputs": {
            "mediaTypes": [
              {
                "mimeType": "application/json",
                "label": "JSON",
                "defaultExtension": "json"
              }
            ]
          },
          "outputs": {
            "mediaTypes": [
              {
                "mimeType": "application/json",
                "label": "JSON",
                "defaultExtension": "json"
              }
            ]
          },
          "code": "{\n  station: .stationName,\n  time: .observedAt,\n  summary: \"\\(.stationName // \"Unknown station\"): \\(.temperature) \u00b0C at \\(.observedAt)\"\n}\n"
        }
      ],
