        "dct:conformsTo": "https://www.w3.org/TR/json-ld11/"
      },
      "dateOfLastChange": "2026-10-01",
      "schema": [
        {
          "prof:hasArtifact": "https://avillar.github.io/bblocks-deep-dive-01/build/annotated/deepdive1/weatherObservation/schema.yaml",
