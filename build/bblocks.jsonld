      "itemIdentifier": "ogc.deepdive1.weatherObservation",
      "name": "Weather Observation",
      "abstract": "A simple weather station observation of air temperature, with semantic uplift to SOSA.",
      "status": "under-development",
      "dateTimeAddition": "2026-10-01T00:00:00Z",
      "itemClass": "schema",
      "version": "0.1",
      "link": "https://blocks.ogc.org",
      "sources": [
        {
          "title": "SOSA/SSN Ontology",
          "link": "https://www.w3.org/TR/vocab-ssn/"
        },
        {
          "title": "OGC SensorThings API Part 1: Sensing",
          "link": "https://www.ogc.org/standards/sensorthings/"
        },
        {
          "title": "WMO Guide to Instruments and Methods of Observation (WMO-No. 8)",
          "link": "https://community.wmo.int/en/activity-areas/imop/wmo-no_8"
        }
      ],
      "tags": [
        "deep-dive",
        "observation",
        "weather"
      ],
      "shaclShapes": null,
      "ldContext": {
        "prof:hasArtifact": "https://avillar.github.io/bblocks-deep-dive-01/build/annotated/deepdive1/weatherObservation/context.jsonld",
